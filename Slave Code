#include <msp430.h>

volatile unsigned char rxData;

void Clock_Init(void)
{
    CSCTL0_H = CSKEY_H;
    CSCTL1 = DCOFSEL_3;
    CSCTL2 = SELM__DCOCLK | SELS__DCOCLK;
    CSCTL3 = DIVM__1 | DIVS__1;
    CSCTL0_H = 0;
}

void I2C_Slave_Init(void)
{
    P1SEL0 |= BIT2 | BIT3;
    P1SEL1 &= ~(BIT2 | BIT3);

    UCB0CTLW0 = UCSWRST;

    UCB0CTLW0 |= UCMODE_3;
    UCB0CTLW0 &= ~UCMST;

    UCB0I2COA0 = 0x48 | UCOAEN;

    UCB0CTLW0 &= ~UCSWRST;

    UCB0IE |= UCRXIE0;
}

int main(void)
{
    WDTCTL = WDTPW | WDTHOLD;

    PM5CTL0 &= ~LOCKLPM5;

    Clock_Init();

    I2C_Slave_Init();

    __enable_interrupt();

    while(1)
    {
        __bis_SR_register(LPM0_bits | GIE);
    }
}

#pragma vector=EUSCI_B0_VECTOR
__interrupt void USCI_B0_ISR(void)
{
    switch(__even_in_range(UCB0IV,30))
    {
        case 22:
            rxData = UCB0RXBUF;
            break;

        default:
            break;
    }
}
