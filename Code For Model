#include <msp430.h>

volatile unsigned char rxData = 0;

void main(void)
{
    WDTCTL = WDTPW | WDTHOLD;

    PM5CTL0 &= ~LOCKLPM5;

    P1SEL0 |= BIT2 | BIT3;
    P1SEL1 &= ~(BIT2 | BIT3);

    UCB0CTLW0 = UCSWRST;

    UCB0CTLW0 |= UCMODE_3;
    UCB0CTLW0 &= ~UCMST;
    UCB0CTLW0 |= UCSYNC;

    UCB0I2COA0 = 0x48 | UCOAEN;

    UCB0CTLW0 &= ~UCSWRST;

    UCB0IE |= UCRXIE0;

    __enable_interrupt();

    while(1)
    {
        __bis_SR_register(LPM0_bits + GIE);
    }
}

#pragma vector = EUSCI_B0_VECTOR
__interrupt void EUSCI_B0_ISR(void)
{
    switch(__even_in_range(UCB0IV,30))
    {
    case 22:
        rxData = UCB0RXBUF;
        break;

    default:
        break;
    }
}
